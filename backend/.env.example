# Server secrets: supabase secrets set --env-file .env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Edge Functions.
ALLOWED_ORIGINS=http://localhost:3000
# Team Next.js AI server BASE URL (without /api/analyze); HTTPS when deployed.
# When set, analyze + TTS use this server instead of the Ubot/direct TTS paths.
AI_SERVER_URL=
AI_SERVER_API_KEY=
ALLOW_LOCAL_AI=false
# Local backend only; hosted Supabase supplies this automatically.
SUPABASE_SERVICE_ROLE_KEY=
UBOT_URL=
UBOT_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3

# Copy only these two to the Next.js team's .env.local:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
